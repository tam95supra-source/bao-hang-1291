<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_overlay_info"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvOverlayStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="INVENT ĐANG TÌM"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOverlaySku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="SKU 12345678"
        android:textColor="@color/white"
        android:textSize="29sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOverlayProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="#EFF8FF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvOverlayMessage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnOverlayAck"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button_success"
        android:text="ĐÃ HIỂU"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvOverlayDismissHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Chạm vùng trống để ẩn"
        android:textColor="#D5E7F5"
        android:textSize="12sp" />
</LinearLayout>

