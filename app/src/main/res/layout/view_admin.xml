<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN TRỊ INVENT"
            android:textColor="@color/navy_900"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cấu hình SLA (phút)"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAckMinutes"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="Thời gian nhận ticket"
                android:inputType="number" />

            <EditText
                android:id="@+id/etReminderMinutes"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Chu kỳ nhắc"
                android:inputType="number" />

            <EditText
                android:id="@+id/etSkipMinutes"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Thời gian được skip"
                android:inputType="number" />

            <EditText
                android:id="@+id/etReplenishMinutes"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Thời gian đang châm"
                android:inputType="number" />

            <Button
                android:id="@+id/btnSaveConfig"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_success"
                android:text="LƯU CẤU HÌNH"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnImportSku"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_primary"
            android:text="ĐỒNG BỘ FILE SKU XLSX"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnImportUsers"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_primary"
            android:text="ĐỒNG BỘ FILE NHÂN SỰ XLSX"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDownloadUserTemplate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_primary"
            android:text="TẢI FILE NHÂN SỰ MẪU"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnSyncSheet"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_success"
            android:text="ĐỒNG BỘ GOOGLE SHEET NGAY"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnOpenInventQueue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_primary"
            android:text="MỞ HÀNG CHỜ INVENT"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tvAdminStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:text="Sẵn sàng"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>

